# 将本示例复制到项目根目录 .env；统一配置入口不读取 server/.env。
# 服务器配置
PORT=3001
HOST=0.0.0.0
# 多个受信任的前端地址以逗号分隔；生产部署请填写实际 HTTPS 地址。
CORS_ORIGIN=http://localhost:3001,http://localhost:8080

# 数据目录配置（./ 开头的路径相对于项目根目录）
DATA_DIR=./server/data

# JWT_SECRET 必须替换为随机密钥；可运行 openssl rand -hex 32 生成。
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 首次启动必填。已有管理员不会被覆盖；初始化后可移除 ADMIN_PASSWORD。
ADMIN_USERNAME=admin
# 至少 12 个字符，UTF-8 编码不超过 72 字节。
ADMIN_PASSWORD=

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs

# 临时文件目录
TMP_DIR=./tmp

# 容器默认为 production；本地开发可用 npm run dev。
NODE_ENV=production
